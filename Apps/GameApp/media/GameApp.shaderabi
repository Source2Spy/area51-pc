    resource SkinInstances
    resource SkinBoneMatrices
    resource SkinBoneRemaps
    resource FaceShadowMatrices
    resource ShadowMapData
    resource GeomLighting
    resource GeomProjectionLighting
    resource GeomAmbient
    resource txDiffuse
    resource txDetail
    resource txEnvironment
    resource txEnvironmentCube
    resource txFaceShadowAtlas
    resource txFaceShadowDepthAtlas
    resource txDistortionScene
    resource txProjectionAtlas
    resource txDamage
    resource cbPrimitiveDraw
    resource txPrimitive
    resource txPrimitiveScene
    resource cbDecalFrame
    resource txDecal
    resource cbShadowCast
    resource ShadowRigidWorld
    resource ShadowSkinBones
    resource cbShadowAlpha
    resource cbShadowFilter
    resource txShadowDepth
    resource txShadowMoments
    resource cbUIDraw
    resource txUI

buffers:
    buffer SceneRegionCopyData SceneRegionCopyConstants SceneRegionParams
    {
        float4 SourceUV 1
    }
    buffer SceneColorGradeData SceneColorGradeConstants SceneColorGradeParams
    {
        float4 Adjustments 1
    }
