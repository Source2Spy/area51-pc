settings:
    config release
    targets vulkan
    binding_model sdl
    source_root shaders
    out_root ../../../build/shaders/GameApp

    contract GameApp.shadercontract

shaders:
    shader xegtao_prepare compute a51_xegtao.hlsl CSPrepare cs_6_0
    {
        common_args "-DA51_AO_PREPARE=1 -DA51_AO_MSAA=0 -DA51_AO_HALF=0"
    }
    shader xegtao_prepare_msaa compute a51_xegtao.hlsl CSPrepare cs_6_0
    {
        common_args "-DA51_AO_PREPARE=1 -DA51_AO_MSAA=1 -DA51_AO_HALF=0"
    }
    shader xegtao_prepare_half compute a51_xegtao.hlsl CSPrepare cs_6_0
    {
        common_args "-DA51_AO_PREPARE=1 -DA51_AO_MSAA=0 -DA51_AO_HALF=1"
    }
    shader xegtao_prepare_half_msaa compute a51_xegtao.hlsl CSPrepare cs_6_0
    {
        common_args "-DA51_AO_PREPARE=1 -DA51_AO_MSAA=1 -DA51_AO_HALF=1"
    }
    shader xegtao_medium compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=2 -DA51_AO_STEPS=2 -DA51_AO_MSAA=0"
    }
    shader xegtao_high compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=3 -DA51_AO_STEPS=3 -DA51_AO_MSAA=0"
    }
    shader xegtao_ultra compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=9 -DA51_AO_STEPS=3 -DA51_AO_MSAA=0"
    }
    shader xegtao_medium_msaa compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=2 -DA51_AO_STEPS=2 -DA51_AO_MSAA=1"
    }
    shader xegtao_high_msaa compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=3 -DA51_AO_STEPS=3 -DA51_AO_MSAA=1"
    }
    shader xegtao_ultra_msaa compute a51_xegtao.hlsl CSMain cs_6_0
    {
        common_args "-DA51_AO_MAIN=1 -DA51_AO_SLICES=9 -DA51_AO_STEPS=3 -DA51_AO_MSAA=1"
    }
    shader xegtao_denoise compute a51_xegtao.hlsl CSDenoise cs_6_0
    {
        common_args "-DA51_AO_DENOISE=1 -DA51_AO_FINAL_DENOISE=0"
    }
    shader xegtao_denoise_final compute a51_xegtao.hlsl CSDenoise cs_6_0
    {
        common_args "-DA51_AO_DENOISE=1 -DA51_AO_FINAL_DENOISE=1"
    }
    shader xegtao_resolve compute a51_xegtao.hlsl CSResolve cs_6_0
    {
        common_args "-DA51_AO_RESOLVE=1"
    }

    shader cloth_tessellate compute a51_cloth_tessellate.hlsl CSMain cs_6_0
    {
    }

    shader cmaa2_init compute a51_cmaa2_init.hlsl InitializeCS cs_6_0
    {
    }

    shader cmaa2_edges compute a51_cmaa2_edges.hlsl EdgesColor2x2CS cs_6_0
    {
    }

    shader cmaa2_args compute a51_cmaa2_args.hlsl ComputeDispatchArgsCS cs_6_0
    {
    }

    shader cmaa2_candidates compute a51_cmaa2_candidates.hlsl ProcessCandidatesCS cs_6_0
    {
    }

    shader cmaa2_apply compute a51_cmaa2_apply.hlsl DeferredColorApply2x2CS cs_6_0
    {
    }
